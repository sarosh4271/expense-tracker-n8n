      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.Date);\nconst end = $now.toFormat('yyyy-MM-dd');\nconst start = $now.minus({ days: 6 }).toFormat('yyyy-MM-dd');\nconst week = rows.filter(r => r.Date >= start && r.Date <= end);\n\nlet total = 0;\nconst byCategory = {};\nfor (const r of week) {\n  const a = Number(r.Amount) || 0;\n  total += a;\n  byCategory[r.Category] = (byCategory[r.Category] || 0) + a;\n}\nconst biggest = week.reduce((m, r) => (Number(r.Amount) > Number(m?.Amount || 0) ? r : m), null);\n\nreturn [{ json: { start, end, count: week.length, total, byCategory, biggest } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "21c3e6cd-7b84-4da9-88c3-065282fb2295",
      "name": "Code in JavaScript"
